---
import '../styles/fuentes.css';
import '../styles/global.scss';
// Fuente del texto de la interfaz (y de la parte principal de casi todas las páginas): se precarga
// para que no espere a que el navegador lea el CSS. Debe ser el mismo archivo que en fuentes.css.
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	/** Ruta local o URL absoluta de la imagen para redes sociales (1200×630). */
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article';
	/** Páginas internas que no deben aparecer en buscadores. */
	noindex?: boolean;
	/** Datos estructurados schema.org de la página. */
	jsonLd?: Record<string, unknown>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/images/og-default.png',
	imageAlt = 'hijoputismo: lo que dijeron, lo que hicieron',
	type = 'website',
	noindex = false,
	jsonLd,
} = Astro.props;

const imageURL = new URL(image, Astro.site);
/** En la pestaña y en los buscadores, el nombre del sitio detrás; en redes ya va en og:site_name. */
const tituloDocumento = title.includes(SITE_TITLE) ? title : `${title} · ${SITE_TITLE}`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#f4f5f8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0f1219" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
{noindex && <meta name="robots" content="noindex" />}
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('rss.xml', Astro.site)} />
<link rel="alternate" type="application/json" title={`${SITE_TITLE} (datos)`} href={new URL('casos.json', Astro.site)} />
<link rel="alternate" type="text/plain" title="llms.txt" href={new URL('llms.txt', Astro.site)} />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta name="generator" content={Astro.generator} />
<!-- Verificación de Google Search Console (propiedad https://hijoputismo.com/); no quitar. -->
<meta name="google-site-verification" content="3huhAWSFZw7XwIcqp1lJd7ljIMPAzgD6j3uqG8VeYHU" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{tituloDocumento}</title>
<meta name="title" content={tituloDocumento} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="es_ES" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

<!--
  Transición entre páginas (global.scss): el título de la tarjeta de un caso vuela hasta su h1, que
  lleva view-transition-name: caso-<slug>. Solo se nombra la tarjeta de esa navegación (la pulsada al
  entrar y la del caso del que se vuelve): con todas nombradas, los casos que salen en varios listados
  volarían de una tarjeta a otra. En línea y sin defer para escuchar pagereveal antes de pintar.
-->
<script is:inline>
	(() => {
		const slug = url => (url && new URL(url).pathname.match(/^\/casos\/([a-z0-9-]+)\/$/)?.[1]) || '';
		const nombrar = s => {
			for (const t of document.querySelectorAll('[data-caso]')) t.style.viewTransitionName = '';
			const t = s && document.querySelector(`[data-caso="${s}"]`);
			if (t) t.style.viewTransitionName = `caso-${s}`;
		};
		addEventListener('pageswap', e => {
			if (e.viewTransition) nombrar(slug(e.activation?.entry?.url));
		});
		addEventListener('pagereveal', e => {
			if (!e.viewTransition) return;
			nombrar(slug(globalThis.navigation?.activation?.from?.url));
			e.viewTransition.finished.finally(() => nombrar(''));
		});
	})();
</script>
