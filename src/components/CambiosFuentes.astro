---
import ExtLink from '@components/ExtLink.astro';
import Fecha from '@components/Fecha.astro';
import type { Caso } from '@utils/casos';

export type CambioFuente = Caso['data']['cambiosFuentes'][number];

interface Props {
	/** Con `caso`, cada cambio enlaza a su caso (página /cambios-en-fuentes/). */
	cambios: (CambioFuente & { caso?: { titulo: string; slug: string } })[];
}

const { cambios } = Astro.props;

const ESTADO = {
	pendiente: 'Pendiente de comprobar qué ha cambiado',
	comprobado: 'Comprobado',
} as const;
---

<ul class="cambios">
	{
		cambios.map(c => (
			<li class="surface cambio">
				<p class="cabecera meta">
					<span>
						Detectado el <Fecha fecha={c.detectado} />
					</span>
					<span class="estado" data-estado={c.estado}>
						<span class="sr-only">Estado:</span>
						{ESTADO[c.estado]}
						{c.estado === 'comprobado' && c.comprobadoEl && (
							<>
								{' el '}
								<Fecha fecha={c.comprobadoEl} />
							</>
						)}
					</span>
				</p>
				{c.caso && (
					<p class="caso">
						<a href={`/casos/${c.caso.slug}/`}>{c.caso.titulo}</a>
					</p>
				)}
				<p class="documento">{c.documento}</p>
				<p>{c.cambio}</p>
				{c.afectaCita !== undefined && (
					<p class="cita">
						{c.afectaCita
							? 'El texto citado en el caso ha cambiado en la versión actual.'
							: 'El texto citado en el caso es el mismo en la versión actual.'}
					</p>
				)}
				<ul class="enlaces meta">
					<li>
						Dirección original: <span class="url">{c.original}</span>
						{c.copiaOriginal && (
							<>
								{' · '}
								<ExtLink href={c.copiaOriginal}>copia archivada del original</ExtLink>
							</>
						)}
					</li>
					{c.actual && (
						<li>
							<ExtLink href={c.actual}>Versión actual</ExtLink>
						</li>
					)}
				</ul>
			</li>
		))
	}
</ul>

<style>
	.cambios {
		display: grid;
		gap: var(--space-4);
	}
	.cambio {
		display: grid;
		gap: var(--space-2);
		padding: var(--space-5);
	}
	.cabecera {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-3);
	}
	.estado {
		display: inline-flex;
		padding: 0.2em 0.65em;
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		line-height: 1.5;
		color: var(--estado-pendiente-fg);
		background: var(--estado-pendiente-bg);
	}
	[data-estado='comprobado'] {
		color: var(--estado-cumplida-fg);
		background: var(--estado-cumplida-bg);
	}
	.caso {
		font-weight: var(--weight-semibold);
	}
	.documento {
		font-weight: var(--weight-medium);
	}
	.cita {
		font-weight: var(--weight-medium);
	}
	.enlaces {
		display: grid;
		gap: var(--space-1);
		margin-top: var(--space-1);
	}
	.url {
		overflow-wrap: anywhere;
	}
</style>
