---
import Fecha from '@components/Fecha.astro';
import Tags from '@components/Tags.astro';
import TipoBadge from '@components/TipoBadge.astro';
import { resumenHito, type Caso } from '@utils/casos';
import { nombreSinCargo } from '@utils/perfiles';

/**
 * Tarjeta de un caso: tipo, título, resumen y el antes/después enfrentados.
 * Toda la tarjeta es clicable (enlace extendido desde el título), pero los tags
 * y el tipo siguen siendo enlaces independientes.
 */
interface Props {
	caso: Caso;
	/** Nivel del título: h2 en listados, h3 dentro de secciones. */
	nivel?: 2 | 3 | 4;
	/** Tarjeta grande para la portada. */
	destacada?: boolean;
}

const { caso, nivel = 2, destacada = false } = Astro.props;
const { title, description, tipo, antes, despues, tags } = caso.data;
const Titulo = `h${nivel}` as 'h2' | 'h3' | 'h4';
const max = destacada ? 220 : 140;
---

<article class:list={['card', { 'card--destacada': destacada }]}>
	<div class="cabecera">
		<TipoBadge tipo={tipo} />
		<p class="meta"><Fecha fecha={antes.fecha} /> <span aria-hidden="true">→</span><span class="sr-only">a</span> <Fecha fecha={despues.fecha} /></p>
	</div>

	<Titulo class="titulo">
		<a href={`/casos/${caso.slug}/`}>{title}</a>
	</Titulo>
	{destacada && <p class="resumen">{description}</p>}

	<div class="versus">
		{
			[
				{ etiqueta: 'Antes', clase: 'antes', hito: antes },
				{ etiqueta: 'Después', clase: 'despues', hito: despues },
			].map(({ etiqueta, clase, hito }) => (
				<div class:list={['lado', clase]}>
					<p class="etiqueta">{etiqueta}</p>
					<p class:list={{ cita: hito.cita }}>{resumenHito(hito, max)}</p>
					<p class="quien">— {nombreSinCargo(hito.quien)}</p>
				</div>
			))
		}
	</div>

	<Tags tags={tags} label={`Políticos y partidos de «${title}»`} />
</article>

<style lang="scss">
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		height: 100%;
		padding: var(--space-6);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
		transition:
			box-shadow var(--duration) var(--ease),
			border-color var(--duration) var(--ease);

		&:hover {
			border-color: var(--color-border-strong);
			box-shadow: var(--shadow-md);
		}
		/* El foco del título se dibuja en toda la tarjeta (si el navegador admite :has). */
		&:has(.titulo a:focus-visible) {
			outline: 3px solid var(--color-focus);
			outline-offset: 2px;
		}
	}
	.cabecera {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2) var(--space-4);
	}
	.titulo {
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		text-wrap: pretty;

		a {
			color: var(--color-text);
			text-decoration: none;

			/* Enlace extendido: cubre toda la tarjeta. */
			&::after {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: inherit;
			}
			@supports selector(:has(*)) {
				&:focus-visible {
					outline: none;
				}
			}
		}
	}
	.card:hover .titulo a {
		text-decoration: underline;
		text-decoration-thickness: 2px;
	}
	.resumen {
		max-width: var(--measure);
		color: var(--color-text-muted);
		font-size: var(--text-md);
	}

	.versus {
		display: grid;
		gap: var(--space-3);
		margin-top: auto;
	}
	.lado {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-3) var(--space-4);
		border-left: 3px solid var(--lado);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		background: var(--lado-bg);
		font-size: var(--text-sm);
	}
	.antes {
		--lado: var(--color-antes);
		--lado-bg: var(--color-antes-soft);
	}
	.despues {
		--lado: var(--color-despues);
		--lado-bg: var(--color-despues-soft);
	}
	.etiqueta {
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--lado);
	}
	.cita {
		font-family: var(--font-serif);
		font-size: var(--text-base);
		font-style: italic;
		line-height: 1.45;
	}
	.quien {
		color: var(--color-text-muted);
	}

	.card--destacada {
		padding: clamp(var(--space-6), 4vw, var(--space-10));

		.titulo {
			font-size: var(--text-3xl);
			line-height: var(--leading-tight);
		}
		.versus {
			@media (min-width: 48rem) {
				grid-template-columns: 1fr 1fr;
			}
		}
		.lado {
			padding: var(--space-4) var(--space-5);
		}
		.cita {
			font-size: var(--text-lg);
		}
	}
</style>
