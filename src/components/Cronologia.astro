---
import Hito from '@components/Hito.astro';
import type { Hito as HitoData } from '@utils/mentiras';

interface Props {
	hitos: HitoData[];
}

const { hitos } = Astro.props;
---

<ol class="cronologia">
	{
		hitos.map(hito => (
			<li>
				<Hito hito={hito} />
			</li>
		))
	}
</ol>

<style lang="scss">
	@use '../styles/breakpoints' as *;

	$dot: 12px;
	$line: 2px;

	.cronologia {
		position: relative;
		display: grid;
		gap: var(--spacing-lg);
		padding-left: var(--spacing-lg);

		&::before {
			content: '';
			position: absolute;
			top: 0;
			bottom: 0;
			left: calc(($dot - $line) / 2);
			width: $line;
			background: #c5c5c5;
		}
	}

	li {
		position: relative;

		&::before {
			content: '';
			position: absolute;
			top: 4px;
			left: calc(-1 * var(--spacing-lg));
			width: $dot;
			height: $dot;
			border-radius: 50%;
			background: var(--accent);
			box-shadow: 0 0 0 3px rgba(35, 55, 255, 0.2);
		}
	}

	@include breakpoint(md) {
		.cronologia {
			padding-left: 0;
			gap: 0;

			&::before {
				left: calc(50% - $line / 2);
			}
		}

		li {
			width: 50%;
			padding: var(--spacing-sm) 40px;

			&:nth-child(odd) {
				text-align: right;

				&::before {
					left: auto;
					right: calc(-1 * $dot / 2);
					top: calc(var(--spacing-sm) + 4px);
				}
			}

			&:nth-child(even) {
				margin-left: 50%;

				&::before {
					left: calc(-1 * $dot / 2);
					top: calc(var(--spacing-sm) + 4px);
				}
			}
		}
	}
</style>
