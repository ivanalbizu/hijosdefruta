---
import Hito from '@components/Hito.astro';
import type { Hito as HitoData } from '@utils/casos';

interface Props {
	hitos: HitoData[];
}

const { hitos } = Astro.props;
---

<ol class="cronologia">
	{
		hitos.map(hito => (
			<li>
				<Hito hito={hito} />
			</li>
		))
	}
</ol>

<style lang="scss">
	$punto: 14px;
	$linea: 2px;

	.cronologia {
		position: relative;
		display: grid;
		gap: var(--space-6);
		padding-left: var(--space-8);

		&::before {
			content: '';
			position: absolute;
			top: 6px;
			bottom: 6px;
			left: calc(($punto - $linea) / 2);
			width: $linea;
			background: var(--color-border-strong);
		}
	}
	li {
		position: relative;
		padding: var(--space-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);

		&::before {
			content: '';
			position: absolute;
			top: calc(var(--space-5) + 4px);
			left: calc(-1 * var(--space-8));
			width: $punto;
			height: $punto;
			border-radius: 50%;
			background: var(--color-surface);
			border: 3px solid var(--color-accent);
		}
	}
</style>
