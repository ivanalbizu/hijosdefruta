---
import ExtLink from '@components/ExtLink.astro';
import Fecha from '@components/Fecha.astro';
import type { Hito } from '@utils/casos';
import { nombreSinCargo } from '@utils/perfiles';

interface Props {
	hitos: Hito[];
}

const { hitos } = Astro.props;

// Una fila por URL, aunque varios hitos compartan fuente.
const fuentes = [...new Map(hitos.map(h => [h.fuente.url, h])).values()];
---

<ol class="fuentes">
	{
		fuentes.map(({ fecha, quien, fuente }) => (
			<li>
				<p class="medio">
					<ExtLink href={fuente.url}>{fuente.medio}</ExtLink>
				</p>
				<p class="meta">
					<Fecha fecha={fecha} /> · {nombreSinCargo(quien)}
					{fuente.archivo && (
						<>
							{' · '}
							<ExtLink href={fuente.archivo}>copia archivada</ExtLink>
						</>
					)}
				</p>
			</li>
		))
	}
</ol>

<style>
	.fuentes {
		counter-reset: fuente;
		display: grid;
	}
	li {
		counter-increment: fuente;
		display: grid;
		grid-template-columns: 2rem 1fr;
		column-gap: var(--space-2);
		padding-block: var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}
	li:last-child {
		border-bottom: 0;
	}
	li::before {
		content: counter(fuente);
		grid-row: span 2;
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		font-variant-numeric: tabular-nums;
		color: var(--color-text-muted);
	}
	.medio {
		font-weight: var(--weight-medium);
	}
</style>
