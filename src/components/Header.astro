---
import HeaderLink from '@components/HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
    <a class="site-title" href="/">{SITE_TITLE}</a>
    <div class="internal-links">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/mentira">Mentiras</HeaderLink>
      <HeaderLink href="/tags">Políticos</HeaderLink>
      <HeaderLink href="/metodologia">Metodología</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
    background: white;
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
  }
  nav a.site-title {
    font-weight: bold;
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: var(--spacing-md);
    width: 1200px;
    max-width: calc(100% - var(--spacing-lg));
    margin: auto;
  }
  nav a {
    padding: 0.5em 0;
    color: var(--black);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }
  .internal-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--spacing-md);
  }
</style>
