---
import HeaderLink from '@components/HeaderLink.astro';
import Logo from '@components/Logo.astro';
import { SITE_TITLE } from '../consts';

const NAV = [
	{ href: '/casos/', texto: 'Casos' },
	{ href: '/tags/', texto: 'Políticos y partidos' },
	{ href: '/promesas/', texto: 'Promesas' },
	{ href: '/metodologia/', texto: 'Metodología' },
];
---

<header class="site-header">
	<div class="container barra">
		<a class="marca" href="/">
			<Logo size={30} />
			<span>{SITE_TITLE}</span>
		</a>
		<nav aria-label="Principal">
			<ul>
				{
					NAV.map(({ href, texto }) => (
						<li>
							<HeaderLink href={href} class="nav-link">
								{texto}
							</HeaderLink>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style lang="scss">
	@use '../styles/breakpoints' as *;

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--color-surface) 88%, transparent);
		backdrop-filter: saturate(1.4) blur(10px);
		border-bottom: 1px solid var(--color-border);
	}
	.barra {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0 var(--space-6);
		min-height: var(--header-height);
	}
	.marca {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: var(--target-min);
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		letter-spacing: -0.02em;
		color: var(--color-text);
		text-decoration: none;
		&:hover {
			color: var(--color-text);
		}
	}

	/* En móvil la navegación ocupa su propia fila y se desplaza en horizontal. */
	nav {
		margin-inline: calc(-1 * var(--gutter));
		padding-inline: var(--gutter);
		width: calc(100% + 2 * var(--gutter));
		overflow-x: auto;
		scrollbar-width: none;

		@include breakpoint(md) {
			width: auto;
			margin: 0;
			padding: 0;
			overflow: visible;
		}
	}
	ul {
		display: flex;
		gap: var(--space-1);
	}
	.nav-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: var(--target-min);
		padding-inline: var(--space-3);
		border-radius: var(--radius-md);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-muted);
		text-decoration: none;
		white-space: nowrap;

		&:hover {
			color: var(--color-text);
			background: var(--color-surface-sunken);
		}
		&.active {
			color: var(--color-text);
			font-weight: var(--weight-semibold);

			&::after {
				content: '';
				position: absolute;
				left: var(--space-3);
				right: var(--space-3);
				bottom: 4px;
				height: 2px;
				border-radius: 2px;
				background: var(--color-accent);
			}
		}
	}
	li:first-child .nav-link {
		margin-left: calc(-1 * var(--space-3));
		@include breakpoint(md) {
			margin-left: 0;
		}
	}
</style>
