---
import Avatar from '@components/Avatar.astro';
import type { TagInfo } from '@utils/mentiras';
import type { Perfil } from '@utils/perfiles';

/** Tarjeta de una persona o partido para los índices. */
interface Props {
	tag: TagInfo;
	perfil?: Perfil;
	partido?: Perfil;
}

const { tag, perfil, partido } = Astro.props;
---

<a class="perfil-card" href={`/tags/${tag.slug}/`}>
	<Avatar nombre={tag.name} perfil={perfil} size="md" />
	<span class="texto">
		<span class="nombre">{tag.name}</span>
		<span class="meta">
			{tag.count} {tag.count === 1 ? 'caso' : 'casos'}{partido && ` · ${partido.data.nombre}`}
		</span>
	</span>
</a>

<style>
	.perfil-card {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		height: 100%;
		padding: var(--space-3) var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		color: var(--color-text);
		text-decoration: none;
		transition:
			border-color var(--duration-fast) var(--ease),
			box-shadow var(--duration-fast) var(--ease);
	}
	.perfil-card:hover {
		color: var(--color-text);
		border-color: var(--color-border-strong);
		box-shadow: var(--shadow-md);
	}
	.perfil-card:hover .nombre {
		text-decoration: underline;
	}
	.texto {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.nombre {
		font-weight: var(--weight-semibold);
		line-height: var(--leading-snug);
	}
	.meta {
		font-size: var(--text-sm);
	}
</style>
