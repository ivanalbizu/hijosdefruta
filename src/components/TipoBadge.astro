---
import { TIPOS } from '../consts';
import type { Mentira } from '@utils/mentiras';

interface Props {
	tipo: Mentira['data']['tipo'];
	/** Enlaza a la explicación del tipo en /metodologia. */
	enlace?: boolean;
}

const { tipo, enlace = true } = Astro.props;
const Tag = enlace ? 'a' : 'span';
---

<Tag class="badge" data-tipo={tipo} href={enlace ? `/metodologia/#${tipo}` : undefined}>
	<span class="punto" aria-hidden="true"></span>
	{TIPOS[tipo].nombre}
</Tag>

<style>
	.badge {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		align-self: flex-start;
		padding: 0.2em 0.65em;
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		line-height: 1.5;
		text-decoration: none;
		white-space: nowrap;
		color: var(--fg);
		background: var(--bg);
	}
	a.badge:hover {
		color: var(--fg);
		box-shadow: inset 0 0 0 1px currentColor;
	}
	.punto {
		width: 0.5em;
		height: 0.5em;
		border-radius: 50%;
		background: currentColor;
	}
	[data-tipo='falsedad'] {
		--fg: var(--tipo-falsedad-fg);
		--bg: var(--tipo-falsedad-bg);
	}
	[data-tipo='promesa-incumplida'] {
		--fg: var(--tipo-promesa-incumplida-fg);
		--bg: var(--tipo-promesa-incumplida-bg);
	}
	[data-tipo='cambio-de-postura'] {
		--fg: var(--tipo-cambio-de-postura-fg);
		--bg: var(--tipo-cambio-de-postura-bg);
	}
	[data-tipo='doble-rasero'] {
		--fg: var(--tipo-doble-rasero-fg);
		--bg: var(--tipo-doble-rasero-bg);
	}
</style>
