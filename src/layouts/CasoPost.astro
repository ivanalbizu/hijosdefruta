---
import Base from '@layouts/Base.astro';
import Tags from '@components/Tags.astro';
import Fecha from '@components/Fecha.astro';
import Hito from '@components/Hito.astro';
import Cronologia from '@components/Cronologia.astro';
import Fuentes from '@components/Fuentes.astro';
import CambiosFuentes from '@components/CambiosFuentes.astro';
import TipoBadge from '@components/TipoBadge.astro';
import Compartir from '@components/Compartir.astro';
import Migas from '@components/Migas.astro';
import CasoCard from '@components/CasoCard.astro';
import { contarFuentes, getCasos, getCasosByTag, getHitos, isoFecha, type Caso } from '@utils/casos';
import { slugifyStr } from '@utils/slugify';
import { getPerfiles, nombreSinCargo } from '@utils/perfiles';
import { organizacion } from '@utils/jsonld';

interface Props {
	caso: Caso;
}

const { caso } = Astro.props;
const { title, description, tipo, tags, antes, despues, cronologia, revisado, cambiosFuentes } = caso.data;
const numFuentes = contarFuentes(caso);
// Generada en src/pages/og/[slug].png.ts
const image = `/og/${caso.slug}.png`;

/*
 * Datos estructurados: Article con cada declaración como `citation` (Quotation con su fecha y su fuente).
 * No se usa ClaimReview: exige una calificación de verdadero/falso y solo encajaría con «falsedad».
 */
const perfiles = await getPerfiles();
/** Tipo schema.org solo si hay perfil; si no, nombre sin tipo para no adivinar. */
const entidad = (nombre: string) => {
	const t = perfiles.get(slugifyStr(nombre))?.data.tipo;
	return { '@type': t === 'partido' ? 'PoliticalParty' : t === 'persona' ? 'Person' : 'Thing', name: nombre };
};
/*
 * «Más casos»: hasta dos tags del caso (personas antes que partidos) con sus tres casos más recientes,
 * sin repetir ninguno. Es lo que busca quien llega desde un buscador o una red social.
 */
const MAX_GRUPOS = 2;
const POR_GRUPO = 3;
const todos = await getCasos();
const vistos = new Set([caso.slug]);
const masCasos = tags
	.map(nombre => ({ nombre, slug: slugifyStr(nombre) }))
	.sort((a, b) => Number(perfiles.get(a.slug)?.data.tipo === 'partido') - Number(perfiles.get(b.slug)?.data.tipo === 'partido'))
	.map(({ nombre, slug }) => {
		const delTag = getCasosByTag(todos, slug);
		const otros = delTag.filter(c => !vistos.has(c.slug)).slice(0, POR_GRUPO);
		otros.forEach(c => vistos.add(c.slug));
		return { nombre, slug, total: delTag.length, casos: otros };
	})
	.filter(g => g.casos.length > 0)
	.slice(0, MAX_GRUPOS);

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	url,
	inLanguage: 'es',
	image: new URL(image, Astro.site).href,
	datePublished: caso.data.pubDate.toISOString().slice(0, 10),
	dateModified: revisado.toISOString().slice(0, 10),
	genre: tipo,
	keywords: tags.join(', '),
	author: organizacion(Astro.site),
	publisher: organizacion(Astro.site),
	about: tags.map(entidad),
	citation: getHitos(caso).map(h => ({
		// Lo que se dijo o hizo, cuándo y quién; la fuente va aparte porque su fecha de publicación puede ser otra.
		...(h.cita ? { '@type': 'Quotation', text: h.cita } : { '@type': 'CreativeWork', description: h.hecho }),
		creator: entidad(nombreSinCargo(h.quien)),
		dateCreated: isoFecha(h.fecha),
		isBasedOn: {
			'@type': 'CreativeWork',
			url: h.fuente.url,
			publisher: { '@type': 'Organization', name: h.fuente.medio },
			...(h.fuente.archivo ? { archivedAt: h.fuente.archivo } : {}),
		},
	})),
};
---

<Base title={title} description={description} image={image} imageAlt={`${title}: antes y después`} type="article" jsonLd={jsonLd}>
	<article class="container page">
		<Migas items={[{ texto: 'Casos', href: '/casos/' }]} actual={title} />

		<header class="cabecera">
			<TipoBadge tipo={tipo} />
			<h1 style={`view-transition-name: caso-${caso.slug}`}>{title}</h1>
			<p class="lead">{description}</p>
			<Tags tags={tags} />
			<p class="meta">
				{numFuentes} {numFuentes === 1 ? 'fuente' : 'fuentes'} · Revisado el <Fecha fecha={revisado} />
			</p>
			<Compartir titulo={title} ruta={`/casos/${caso.slug}/`} compacto />
		</header>

		{/*
			Modo lectura (Readability): «texto-caso» da peso a los paneles y al comentario para que no se
			queden fuera del artículo, y «related» descarta «Más casos». Son clases sin estilos.
		*/}
		<section class="versus texto-caso" aria-labelledby="titulo-antes-despues">
			<h2 id="titulo-antes-despues" class="sr-only">Antes y después</h2>
			<div class="panel antes">
				<h3 class="etiqueta">Antes</h3>
				<Hito hito={antes} nivel={4} grande />
			</div>
			<div class="panel despues">
				<h3 class="etiqueta">Después</h3>
				<Hito hito={despues} nivel={4} grande />
			</div>
		</section>

		<div class="cuerpo">
			{
				cronologia.length > 0 && (
					<section class="bloque" aria-labelledby="titulo-cronologia">
						<h2 id="titulo-cronologia" class="h3">Cronología</h2>
						<p class="meta">Lo que pasó entre una declaración y la otra.</p>
						<Cronologia hitos={cronologia} />
					</section>
				)
			}

			<div class="comentario prose texto-caso">
				<slot />
			</div>

			<section class="bloque" aria-labelledby="titulo-fuentes">
				<h2 id="titulo-fuentes" class="h3">Fuentes</h2>
				<div class="surface fuentes">
					<Fuentes hitos={getHitos(caso)} />
				</div>
				<p class="meta revisado">
					Citas, fechas y enlaces revisados el <Fecha fecha={revisado} />. ¿Ves un error?
					<a href="/metodologia/#correcciones">Así se corrige</a>.
				</p>
			</section>

			{
				cambiosFuentes.length > 0 && (
					<section class="bloque" aria-labelledby="titulo-cambios">
						<h2 id="titulo-cambios" class="h3">Cambios en las fuentes</h2>
						<p class="meta">
							Cambios que hemos detectado en los documentos citados después de publicar el caso. Todos están en
							<a href="/cambios-en-fuentes/">el registro de cambios en las fuentes</a>.
						</p>
						<CambiosFuentes cambios={cambiosFuentes} />
					</section>
				)
			}

			<section class="bloque surface compartir-final" aria-label="Compartir">
				<Compartir titulo={title} ruta={`/casos/${caso.slug}/`} />
			</section>
		</div>

		{
			masCasos.length > 0 && (
				<section class="bloque mas-casos related" aria-labelledby="titulo-mas-casos">
					<h2 id="titulo-mas-casos" class="h3">Más casos</h2>
					{masCasos.map(g => (
						<section class="grupo" aria-labelledby={`mas-${g.slug}`}>
							<div class="section-header">
								<h3 id={`mas-${g.slug}`} class="h4">{g.nombre}</h3>
								<a class="link-arrow" href={`/tags/${g.slug}/`}>
									Todos sus casos <span class="sr-only">({g.nombre}: {g.total})</span>
								</a>
							</div>
							<ul class="grid-cards">
								{g.casos.map(c => (
									<li>
										<CasoCard caso={c} nivel={4} />
									</li>
								))}
							</ul>
						</section>
					))}
				</section>
			)
		}
	</article>
</Base>

<style lang="scss">

	@use '../styles/breakpoints' as *;

	.compartir-final {
		padding: var(--space-5);
	}

	.cabecera {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
		max-width: 56rem;
		margin-bottom: var(--space-10);

		h1 {
			font-size: clamp(1.75rem, 2.2vw + 1.2rem, 2.75rem);
		}
		.lead {
			margin-top: 0;
		}
	}

	.versus {
		position: relative;
		display: grid;
		gap: var(--space-6);

		@include breakpoint(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.panel {
		position: relative;
		padding: var(--space-6);
		padding-top: var(--space-8);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-top: 4px solid var(--lado);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
	}
	.antes {
		--lado: var(--color-antes);
		--lado-bg: var(--color-antes-soft);
	}
	.despues {
		--lado: var(--color-despues);
		--lado-bg: var(--color-despues-soft);
	}
	.etiqueta {
		position: absolute;
		top: -0.85rem;
		left: var(--space-6);
		padding: 0.15rem 0.7rem;
		border-radius: var(--radius-full);
		background: var(--lado-bg);
		border: 1px solid var(--lado);
		color: var(--lado);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		line-height: 1.5;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.cuerpo {
		max-width: 52rem;
	}
	.bloque {
		margin-top: var(--space-16);

		> .meta {
			margin-block: var(--space-1) var(--space-6);
		}
		> h2 + .surface {
			margin-top: var(--space-4);
		}
	}
	.comentario:not(:empty) {
		margin-top: var(--space-12);
	}
	.fuentes {
		padding: var(--space-2) var(--space-5);
	}
	.mas-casos {
		padding-top: var(--space-12);
		border-top: 1px solid var(--color-border);

		> h2 {
			margin-bottom: var(--space-6);
		}
	}
	.grupo + .grupo {
		margin-top: var(--space-10);
	}
	.revisado {
		margin-top: var(--space-4);
	}
</style>
