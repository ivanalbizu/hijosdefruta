---
import Default from '@layouts/Default.astro';
import CasoCard from '@components/CasoCard.astro';
import { aniosCaso, getCasos, getTags, textoBusqueda } from '@utils/casos';
import { slugifyStr } from '@utils/slugify';
import { getPerfiles } from '@utils/perfiles';
import { TEMAS, TIPOS } from '../consts';

/*
 * Búsqueda y filtros. Todas las tarjetas se generan en el build con su índice en
 * atributos data-*; el script las muestra u oculta. Sin JavaScript se ven todos los casos.
 * Los filtros se reflejan en la URL (?q=&tema=&tipo=&quien=&anio=) para poder compartirlos.
 */
const casos = await getCasos();
const temas = Object.entries(TEMAS)
  .map(([slug, { nombre }]) => ({ slug, nombre, count: casos.filter(c => c.data.temas.includes(slug as keyof typeof TEMAS)).length }))
  .filter(t => t.count)
  .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));
const tags = getTags(casos).sort((a, b) => a.name.localeCompare(b.name, 'es'));
const perfiles = await getPerfiles();
const grupos = [
  { etiqueta: 'Personas', tags: tags.filter(t => perfiles.get(t.slug)?.data.tipo !== 'partido') },
  { etiqueta: 'Partidos', tags: tags.filter(t => perfiles.get(t.slug)?.data.tipo === 'partido') },
].filter(g => g.tags.length);
const anios = [...new Set(casos.flatMap(aniosCaso))].sort((a, b) => b - a);
---

<Default
  title="Buscar casos"
  description="Busca entre los casos por texto, tema, tipo de contradicción, persona o partido y año"
  lead="Busca en los títulos, las citas y los hechos de cada caso, o filtra por tema, tipo, persona o partido y año.">
  <form class="filtros surface" id="filtros" action="/buscar/" method="get" role="search" aria-label="Buscar casos"
    toolname="buscar_casos_formulario"
    tooldescription="Filtra los casos de contradicciones de políticos españoles por texto, tema, tipo, persona o partido y año">
    <div class="campo campo--texto">
      <label for="q">Texto</label>
      <input id="q" name="q" type="search" autocomplete="off" placeholder="Ej.: amnistía, indulto, Cámara…"
        toolparamdescription="Texto a buscar en títulos, citas y hechos" />
    </div>
    <div class="campo">
      <label for="tema">Tema</label>
      <select id="tema" name="tema" toolparamdescription="Tema del caso">
        <option value="">Todos</option>
        {temas.map(t => <option value={t.slug}>{t.nombre} ({t.count})</option>)}
      </select>
    </div>
    <div class="campo">
      <label for="tipo">Tipo</label>
      <select id="tipo" name="tipo">
        <option value="">Todos</option>
        {Object.entries(TIPOS).map(([valor, { nombre }]) => <option value={valor}>{nombre}</option>)}
      </select>
    </div>
    <div class="campo">
      <label for="quien">Persona o partido</label>
      <select id="quien" name="quien" toolparamdescription="Slug de la persona o partido">
        <option value="">Todos</option>
        {
          grupos.map(g => (
            <optgroup label={g.etiqueta}>
              {g.tags.map(t => <option value={t.slug}>{t.name} ({t.count})</option>)}
            </optgroup>
          ))
        }
      </select>
    </div>
    <div class="campo">
      <label for="anio">Año</label>
      <select id="anio" name="anio">
        <option value="">Todos</option>
        {anios.map(a => <option value={a}>{a}</option>)}
      </select>
    </div>
    <div class="acciones">
      <!-- Lleva a la lista, que en el móvil queda debajo del formulario. Sin JavaScript no filtra: oculto. -->
      <button class="btn btn--primary" type="submit" id="ver" hidden>Ver {casos.length} casos</button>
      <button class="btn btn--secondary" type="reset">Limpiar</button>
    </div>
  </form>

  <p class="estado" id="estado" role="status" aria-live="polite" aria-atomic="true" tabindex="-1">
    {casos.length} casos
  </p>

  <ul class="grid-cards" id="resultados" aria-label="Resultados">
    {
      casos.map(caso => (
        <li
          data-tema={caso.data.temas.join(' ')}
          data-tipo={caso.data.tipo}
          data-quien={caso.data.tags.map(slugifyStr).join(' ')}
          data-anio={aniosCaso(caso).join(' ')}
          data-texto={textoBusqueda(caso)}>
          <CasoCard caso={caso} />
        </li>
      ))
    }
  </ul>
  <p class="vacio" id="vacio" hidden>
    Ningún caso coincide con la búsqueda. Prueba con menos filtros u otras palabras.
  </p>
</Default>

<script>
  import { filtroTexto } from '@utils/busqueda';

  const form = document.getElementById('filtros') as HTMLFormElement;
  const estado = document.getElementById('estado')!;
  const vacio = document.getElementById('vacio')!;
  const ver = document.getElementById('ver')!;
  const items = [...document.querySelectorAll<HTMLLIElement>('#resultados > li')];
  const campos = ['q', 'tema', 'tipo', 'quien', 'anio'] as const;

  const control = (n: string) => form.elements.namedItem(n) as HTMLInputElement | HTMLSelectElement;

  let temporizador: number | undefined;

  function filtrar({ anunciar = true } = {}) {
    const coincide = filtroTexto(control('q').value);
    const tema = control('tema').value;
    const tipo = control('tipo').value;
    const quien = control('quien').value;
    const anio = control('anio').value;

    let n = 0;
    for (const li of items) {
      const d = li.dataset;
      const ok =
        (!tema || d.tema!.split(' ').includes(tema)) &&
        (!tipo || d.tipo === tipo) &&
        (!quien || d.quien!.split(' ').includes(quien)) &&
        (!anio || d.anio!.split(' ').includes(anio)) &&
        coincide(d.texto!);
      li.hidden = !ok;
      if (ok) n++;
    }
    vacio.hidden = n > 0;
    ver.textContent = n ? `Ver ${n} ${n === 1 ? 'caso' : 'casos'}` : 'Ver resultados';

    // URL compartible sin crear entradas en el historial.
    const params = new URLSearchParams();
    for (const c of campos) if (control(c).value.trim()) params.set(c, control(c).value.trim());
    const url = params.size ? `?${params}` : location.pathname;
    history.replaceState(null, '', url);

    // El anuncio espera a que se deje de escribir para no leer cada pulsación.
    clearTimeout(temporizador);
    const texto = `${n} ${n === 1 ? 'caso' : 'casos'}${params.size ? ` de ${items.length}` : ''}`;
    if (anunciar) temporizador = window.setTimeout(() => (estado.textContent = texto), 400);
    else estado.textContent = texto;
  }

  // Estado inicial desde la URL.
  const inicial = new URLSearchParams(location.search);
  for (const c of campos) {
    const v = inicial.get(c);
    if (v) control(c).value = v;
  }
  filtrar({ anunciar: false });
  ver.hidden = false;

  form.addEventListener('input', () => filtrar());
  // «Ver N casos» lleva a la lista y deja el foco en el número de resultados. Enter en el campo de texto
  // hace lo mismo solo si la lista no se ve (en el móvil); si ya se ve, el foco sigue en el campo.
  form.addEventListener('submit', e => {
    e.preventDefault();
    filtrar({ anunciar: false });
    // scroll-padding-top (global.scss) es lo que tapa la cabecera fija; scrollIntoView ya lo descuenta y
    // es suave o no según prefers-reduced-motion.
    const tapa = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
    const { top } = estado.getBoundingClientRect();
    const seVe = top >= tapa && top < window.innerHeight * 0.75;
    if (document.activeElement === control('q') && seVe) return;
    if (!seVe) estado.scrollIntoView({ block: 'start' });
    estado.focus({ preventScroll: true });
  });
  // `reset` se dispara antes de vaciar los campos.
  form.addEventListener('reset', () => setTimeout(() => {
    filtrar();
    control('q').focus();
  }));
</script>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .filtros {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    margin-bottom: var(--space-6);

    // Con cuatro desplegables, el texto ocupa su propia fila hasta que caben todos en una.
    @include breakpoint(md) {
      grid-template-columns: repeat(4, 1fr);
      align-items: end;
    }
    @include breakpoint(xl) {
      grid-template-columns: 2fr repeat(4, 1fr);
    }
  }
  .campo--texto {
    @include breakpoint(md) {
      grid-column: 1 / -1;
    }
    @include breakpoint(xl) {
      grid-column: auto;
    }
  }
  .campo {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }
  label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  input,
  select {
    min-height: var(--target-min);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-control);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    width: 100%;
  }
  input::placeholder {
    color: var(--color-text-muted);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    grid-column: 1 / -1;
  }
  .estado {
    margin-bottom: var(--space-4);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }
  #resultados > li[hidden],
  .vacio[hidden],
  .btn[hidden] {
    display: none;
  }
  .vacio {
    padding: var(--space-8) 0;
    color: var(--color-text-muted);
  }
</style>
