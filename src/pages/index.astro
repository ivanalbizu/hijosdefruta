---
import { getCollection } from 'astro:content';
import Base from '@layouts/Base.astro';
import CasoCard from '@components/CasoCard.astro';
import PerfilCard from '@components/PerfilCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION, TIPOS } from '../consts';
import { getCasos, getFeatured, getTags, getHitos } from '@utils/casos';
import { getPerfiles } from '@utils/perfiles';

const casos = await getCasos();
const destacado = getFeatured(casos);
const recientes = casos.filter(c => c !== destacado).slice(0, 6);
const tags = getTags(casos);
const perfiles = await getPerfiles();
const promesas = await getCollection('promesa');

const fuentes = new Set(casos.flatMap(c => getHitos(c).map(h => h.fuente.url))).size;
const cifras = [
  { valor: casos.length, texto: 'casos documentados' },
  { valor: fuentes, texto: 'fuentes enlazadas' },
  { valor: tags.length, texto: 'políticos y partidos' },
  { valor: promesas.length, texto: 'promesas archivadas' },
];

const top = tags.slice(0, 8).map(tag => {
  const perfil = perfiles.get(tag.slug);
  return { tag, perfil, partido: perfil?.data.partido ? perfiles.get(perfil.data.partido) : undefined };
});
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Hemeroteca con fuentes</p>
      <h1>Lo que dijeron.<br /><span class="despues">Lo que hicieron.</span></h1>
      <p class="lead">
        Declaraciones de políticos enfrentadas a lo que dijeron o hicieron después, con la cita literal, la fecha
        y un enlace a la fuente primaria de cada una.
      </p>
      <div class="acciones">
        <a class="btn btn--primary" href="/casos/">Ver los casos</a>
        <a class="btn btn--secondary" href="/metodologia/">Cómo se verifican</a>
      </div>
      <dl class="cifras">
        {
          cifras.map(({ valor, texto }) => (
            <div>
              <dt>{texto}</dt>
              <dd>{valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <div class="container">
    {
      destacado && (
        <section class="section" aria-labelledby="titulo-destacado">
          <h2 id="titulo-destacado" class="eyebrow">Caso destacado</h2>
          <div class="destacado">
            <CasoCard caso={destacado} nivel={3} destacada />
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby="titulo-recientes">
      <div class="section-header">
        <h2 id="titulo-recientes" class="h3">Últimos casos</h2>
        <a class="link-arrow" href="/casos/">Todos los casos <span class="sr-only">({casos.length})</span></a>
      </div>
      <ul class="grid-cards">
        {
          recientes.map(caso => (
            <li>
              <CasoCard caso={caso} nivel={3} />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="titulo-perfiles">
      <div class="section-header">
        <h2 id="titulo-perfiles" class="h3">Con más casos</h2>
        <a class="link-arrow" href="/tags/">Todos los políticos y partidos</a>
      </div>
      <ul class="perfiles">
        {top.map(i => <li><PerfilCard {...i} /></li>)}
      </ul>
    </section>

    <section class="section tipos surface" aria-labelledby="titulo-tipos">
      <div>
        <h2 id="titulo-tipos" class="h3">No todo es una mentira</h2>
        <p class="meta">Cada caso se clasifica según lo que las pruebas permiten afirmar.</p>
        <a class="link-arrow" href="/metodologia/">Metodología completa</a>
      </div>
      <dl>
        {
          Object.entries(TIPOS).map(([id, tipo]) => (
            <div data-tipo={id}>
              <dt>{tipo.nombre}</dt>
              <dd>{tipo.descripcion}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Base>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .hero {
    padding-block: clamp(var(--space-12), 8vw, var(--space-20)) var(--space-10);
    background:
      radial-gradient(60rem 30rem at 85% -10%, var(--color-despues-soft), transparent 70%),
      radial-gradient(50rem 30rem at 0% 0%, var(--color-antes-soft), transparent 70%);
    border-bottom: 1px solid var(--color-border);

    h1 {
      margin-top: var(--space-3);
      font-size: clamp(2.25rem, 5vw + 1rem, 4.25rem);
      line-height: 1.05;
      letter-spacing: -0.035em;
    }
  }
  .despues {
    color: var(--color-despues);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .cifras {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);

    @include breakpoint(md) {
      grid-template-columns: repeat(4, 1fr);
    }
    div {
      display: flex;
      flex-direction: column-reverse;
    }
    dt {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }
    dd {
      margin: 0;
      font-size: var(--text-3xl);
      font-weight: var(--weight-bold);
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }
  }

  .destacado {
    margin-top: var(--space-4);
  }

  .perfiles {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }

  .tipos {
    display: grid;
    gap: var(--space-8);
    padding: clamp(var(--space-6), 4vw, var(--space-10));

    @include breakpoint(lg) {
      grid-template-columns: 1fr 2fr;
    }
    .meta {
      margin-block: var(--space-2) var(--space-4);
    }
    dl {
      display: grid;
      gap: var(--space-5);
      @include breakpoint(sm) {
        grid-template-columns: 1fr 1fr;
      }
    }
    dl > div {
      padding-left: var(--space-4);
      border-left: 3px solid var(--fg);
    }
    dt {
      font-weight: var(--weight-semibold);
      color: var(--fg);
    }
    dd {
      margin: var(--space-1) 0 0;
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }
    @each $tipo in falsedad, promesa-incumplida, cambio-de-postura, doble-rasero {
      [data-tipo='#{$tipo}'] {
        --fg: var(--tipo-#{$tipo}-fg);
      }
    }
  }
</style>
