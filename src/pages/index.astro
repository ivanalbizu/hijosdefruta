---
import BaseHead from '@components/BaseHead.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Media from '@components/Media.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import TipoBadge from '@components/TipoBadge.astro';
import { getMentiras, getFeatured, getTags, getVideoPrincipal } from '@utils/mentiras';

const mentiras = await getMentiras();
const mentira = getFeatured(mentiras);
const video = mentira && getVideoPrincipal(mentira);
const tags = getTags(mentiras).slice(0, 20);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>Mentirosos</h1>
      <div class="row">
        {
          mentira && (
            <div>
              <TipoBadge tipo={mentira.data.tipo} />
              <h2 class="h3">{mentira.data.title}</h2>
              {video && <Media id={video.id} title={video.titulo ?? mentira.data.title} start={video.start} end={video.end} />}
              <p>{mentira.data.description}</p>
              <a href={`/mentira/${mentira.slug}/`}>
                Ver la mentira <span class="sr-only">{mentira.data.title}</span>
              </a>
            </div>
          )
        }
        <div>
          <h2 class="h3">Trending mentirosos</h2>
          <ul class="tags">
            {tags.map(tag => (
              <li><a href={`/tags/${tag.slug}/`}>{tag.name} <span class="count">({tag.count})</span></a></li>
            ))}
          </ul>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style lang="scss">
  .row {
    display: grid;
    gap: var(--spacing-sm);

    @media (min-width: 576px) {
      grid-template-columns: 2fr 3fr;
    }
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2xs);
    a {
      display: inline-block;
      font-size: 14px;
      padding: var(--spacing-2xs) var(--spacing-xs);
      background-color: var(--accent-dark);
      border-radius: 2px;
      color: #fff;
    }
  }
</style>
