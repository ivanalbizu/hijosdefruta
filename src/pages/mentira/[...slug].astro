---
import MentiraPost from '@layouts/MentiraPost.astro';
import { getMentiras, type Mentira } from '@utils/mentiras';

export async function getStaticPaths() {
	const mentiras = await getMentiras();
	return mentiras.map(mentira => ({
		params: { slug: mentira.slug },
		props: { mentira },
	}));
}

interface Props {
	mentira: Mentira;
}

const { mentira } = Astro.props;
const { Content } = await mentira.render();
---

<MentiraPost mentira={mentira}>
	<Content />
</MentiraPost>
