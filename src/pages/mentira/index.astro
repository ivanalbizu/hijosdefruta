---
import Default from '@layouts/Default.astro';
import MentiraCard from '@components/MentiraCard.astro';
import { getMentiras } from '@utils/mentiras';

const mentiras = await getMentiras();
---

<Default
  title="Casos"
  description="Mentiras y cambios de opinión de políticos españoles, con la cita literal y la fuente de cada declaración"
  eyebrow={`${mentiras.length} casos documentados`}
  lead="Cada caso enfrenta lo que se dijo antes con lo que se dijo o hizo después. Ordenados por la fecha de la contradicción, de la más reciente a la más antigua.">
  <ul class="grid-cards">
    {
      mentiras.map(mentira => (
        <li>
          <MentiraCard mentira={mentira} />
        </li>
      ))
    }
  </ul>
</Default>
