---
import Default from '@layouts/Default.astro';
import MentiraCard from '@components/MentiraCard.astro';
import { getMentiras, getMentirasByTag, getTags, type Mentira, type TagInfo } from '@utils/mentiras';

export async function getStaticPaths() {
  const mentiras = await getMentiras();
  return getTags(mentiras).map(tag => ({
    params: { tag: tag.slug },
    props: { tag, mentiras: getMentirasByTag(mentiras, tag.slug) },
  }));
}

interface Props {
  tag: TagInfo;
  mentiras: Mentira[];
}

const { tag, mentiras } = Astro.props;
---

<Default title={`Mentiras: ${tag.name}`} description={`Mentiras y cambios de opinión de ${tag.name}`}>
  <ul>
    {mentiras.map(mentira => <MentiraCard mentira={mentira} />)}
  </ul>
</Default>
