---
import Default from '@layouts/Default.astro';
import { getMentiras, getTags } from '@utils/mentiras';

const tags = getTags(await getMentiras());
---

<Default title="Tags" description="Mentiras agrupadas por político y partido">
  <ul>
    {tags.map(tag => (
      <li>
        <a href={`/tags/${tag.slug}/`}>{tag.name}</a> ({tag.count})
      </li>
    ))}
  </ul>
</Default>
